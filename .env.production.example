APP_NAME="SPK SMART Laravel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-production-app.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Database Configuration (PostgreSQL / Supabase / Render)
DB_CONNECTION=pgsql
# Masukkan full PostgreSQL connection string Anda (contoh: postgresql://user:password@host:5432/database)
DATABASE_URL=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
